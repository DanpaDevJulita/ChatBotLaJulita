# --- IA (necesaria ya, para el chat local) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Opcional: modelo para el orquestador (el router que corre en CADA turno, antes que
# cualquier agente — conviene uno rápido/barato). Si lo dejas vacío, usa OPENROUTER_MODEL.
# ORCHESTRATOR_MODEL=

# --- WhatsApp (YCloud) — necesarias para conectar el número real de pruebas ---
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
# El número que da YCloud, en formato E.164: +573246166787
YCLOUD_FROM_PHONE_NUMBER=
YCLOUD_BASE_URL=https://api.ycloud.com
# En true, no manda mensajes reales — los imprime en la consola (útil antes de tener todo listo)
YCLOUD_DRY_RUN=false

PORT=3000

# --- Base de datos (Supabase) — planes, adicionales, horarios, FAQ, historial de mensajes ---
# La URL y la "service role key" (¡NO la "anon key"!) están en tu proyecto de Supabase, en
# Project Settings → API. La service role key salta la seguridad de fila (RLS) — por eso
# NUNCA debe llegar al navegador, solo la usa este servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administración (/admin) ---
# Contraseña compartida para el equipo de ventas — cámbiala por algo tuyo, no dejes esto vacío.
ADMIN_PASSWORD=
# Cualquier texto largo y aleatorio — se usa para firmar la cookie de sesión del panel.
SESSION_SECRET=

# --- Colas (Redis) — separa el proceso web del worker, igual que en agente-ycloud-main ---
# El webhook de WhatsApp (proceso web, `npm run web`) ya NO procesa el mensaje directo: lo
# encola en Redis y responde de una vez. Un proceso worker aparte (`npm run worker`) es quien
# de verdad lo procesa — ver src/core/queue/ y src/worker/. Sin REDIS_URL configurado (o sin
# el worker corriendo), los mensajes se quedan esperando en la cola y el cliente nunca recibe
# respuesta, así que ambos procesos (web y worker) deben estar corriendo al mismo tiempo.
#
# Necesitas un servidor de Redis corriendo en algún lado. Opciones sencillas:
#   - Docker en tu máquina: docker run -p 6379:6379 redis
#   - Un Redis gratis en la nube si no quieres instalar nada (ej. Upstash, upstash.com)
REDIS_URL=redis://127.0.0.1:6379

# --- LobbyPMS API oficial ---
# Token del panel de LobbyPMS (Configuraciones -> API). La API tambien exige
# autorizar ahi la IP de salida del servidor donde corre el bot.
LOBBYPMS_API_TOKEN=
LOBBYPMS_API_URL=https://api.lobbypms.com/api/v1
# Opcional. Id del canal de venta en LobbyPMS (GET /api/v1/channels) para distinguir ahi las
# reservas que crea el bot de las que carga un vendedor. Si se deja vacio, la reserva se crea
# sin canal asignado (no falla por esto).
LOBBYPMS_CHANNEL_ID=
