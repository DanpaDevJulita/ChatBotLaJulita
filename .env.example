# --- IA (necesaria ya, para el chat local) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Opcional: modelo para el orquestador (el router que corre en CADA turno, antes que
# cualquier agente — conviene uno rápido/barato). Si lo dejas vacío, usa OPENROUTER_MODEL.
# ORCHESTRATOR_MODEL=
# [2026-09-14] Reconocimiento de audio (notas de voz de WhatsApp) — ver core/llm/whisper.ts.
# OpenRouter no expone el endpoint /audio/transcriptions de Whisper, así que se usa un modelo
# multimodal con soporte de audio (mismo enfoque que agente-ycloud-main, "Sebas Raider"). Si lo
# dejas vacío, usa este default.
# OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# --- WhatsApp (YCloud) — necesarias para conectar el número real de pruebas ---
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
# El número que da YCloud, en formato E.164: +573246166787
YCLOUD_FROM_PHONE_NUMBER=
YCLOUD_BASE_URL=https://api.ycloud.com
# En true, no manda mensajes reales — los imprime en la consola (útil antes de tener todo listo)
YCLOUD_DRY_RUN=false
# [2026-09-15] Id del catálogo de Meta (Commerce Manager) conectado a este WABA, para
# mandar el menú de planes como mensaje de catálogo (gratis, no es plantilla) — ver
# REFERENCIA-CATALOGO-WHATSAPP.md. Vacío = el bot no manda el catálogo, solo el texto de
# siempre (nunca falla el turno por esto).
YCLOUD_CATALOG_ID=

PORT=3000

# --- Base de datos (Supabase) — planes, adicionales, horarios, FAQ, historial de mensajes ---
# La URL y la "service role key" (¡NO la "anon key"!) están en tu proyecto de Supabase, en
# Project Settings → API. La service role key salta la seguridad de fila (RLS) — por eso
# NUNCA debe llegar al navegador, solo la usa este servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administración (/admin) ---
# Contraseña compartida para el equipo de ventas — cámbiala por algo tuyo, no dejes esto vacío.
ADMIN_PASSWORD=
# Cualquier texto largo y aleatorio — se usa para firmar la cookie de sesión del panel.
SESSION_SECRET=

# --- Colas (Redis) — separa el proceso web del worker, igual que en agente-ycloud-main ---
# El webhook de WhatsApp (proceso web, `npm run web`) ya NO procesa el mensaje directo: lo
# encola en Redis y responde de una vez. Un proceso worker aparte (`npm run worker`) es quien
# de verdad lo procesa — ver src/core/queue/ y src/worker/. Sin REDIS_URL configurado (o sin
# el worker corriendo), los mensajes se quedan esperando en la cola y el cliente nunca recibe
# respuesta, así que ambos procesos (web y worker) deben estar corriendo al mismo tiempo.
#
# Necesitas un servidor de Redis corriendo en algún lado. Opciones sencillas:
#   - Docker en tu máquina: docker run -p 6379:6379 redis
#   - Un Redis gratis en la nube si no quieres instalar nada (ej. Upstash, upstash.com)
REDIS_URL=redis://127.0.0.1:6379

# [2026-09-14] Cuánto espera el bot, en milisegundos, a que el cliente termine de escribir antes
# de procesar sus mensajes — ver core/queue/inboundQueue.ts. Si el cliente manda varios mensajes
# seguidos y separados (típico cuando escribe datos a mano: documento, cédula, edad en mensajes
# sueltos), el bot los junta en UN solo turno en vez de contestar cada uno por separado. Cada
# mensaje nuevo de la misma conversación reinicia este plazo desde cero. Mismo valor que
# agente-ycloud-main ("Sebas Raider") tiene en producción — el equipo probó 8 segundos primero y
# resultó corto para ese patrón de escritura, por eso quedó en 20.
# DEBOUNCE_MS=20000

# --- LobbyPMS API oficial ---
# Token del panel de LobbyPMS (Configuraciones -> API). La API tambien exige
# autorizar ahi la IP de salida del servidor donde corre el bot.
LOBBYPMS_API_TOKEN=
LOBBYPMS_API_URL=https://api.lobbypms.com/api/v1
# Opcional. Id del canal de venta en LobbyPMS (GET /api/v1/channels) para distinguir ahi las
# reservas que crea el bot de las que carga un vendedor. Si se deja vacio, la reserva se crea
# sin canal asignado (no falla por esto).
LOBBYPMS_CHANNEL_ID=

# --- ¿El bot crea la reserva en la base? ---
# [2026-09-11] EN true ES OBLIGATORIO PARA QUE FUNCIONE EL LINK DE PAGO.
#
# Historia: el 2026-09-08 se decidió que el bot NO creara la reserva (la armaba el equipo al
# asignar el domo, dato que el bot no tiene). Con eso, el bot solo guardaba el cliente y los
# acompañantes — nunca una fila en `reservas`.
#
# Desde que existe el módulo de pagos eso ya no alcanza: para cobrar hay que tener una reserva
# (el link se genera CONTRA una reserva, y el webhook confirma ESA reserva). Por eso `domo_id`
# quedó opcional (sql/pagos-migracion-reservas.sql): el bot crea la reserva SIN domo asignado y
# el equipo asigna el domo después, cuando confirma el cupo.
#
# Si esto queda en false (o sin poner): el bot pide todos los datos, los guarda, y al llegar al
# pago no encuentra ninguna reserva que cobrar — entonces le dice al cliente que "el equipo le
# envía los datos de pago en un momento" y el link NUNCA llega.
CREAR_RESERVA_DESDE_BOT=true

# --- Pagos (Bold) — links de pago de las reservas ---
# La "Llave de identidad" del comercio, en Bold -> Integraciones -> Llaves de integracion.
# Sirve para la API de Link de pagos (POST /online/link/v1); NO hace falta activar el producto
# aparte "API Pagos en Linea", que es otra cosa. Sin esta variable el bot no genera links: el
# agente de ventas deriva el pago al equipo y lo avisa por consola al arrancar.
BOLD_API_KEY=
# Solo se cambia para apuntar al ambiente de pruebas de Bold.
BOLD_BASE_URL=https://integrations.api.bold.co

# --- Webhook de Bold (confirma automaticamente que el pago SI entro) ---
# [2026-09-11] En el panel de Bold, en la config del webhook, la URL a poner es:
#   <tu-url-publica>/webhooks/bold
# Mientras pruebas: la que te da `cloudflared tunnel --url http://localhost:3000` (OJO: esa URL
# cambia cada vez que reinicias el tunel — hay que volver a pegarla en Bold). En produccion
# deberia ser un dominio fijo, si no toca actualizar la URL en Bold cada reinicio.
#
# Bold firma cada webhook con HMAC-SHA256 sobre el body en Base64, en el header
# x-bold-signature — pero su documentacion no deja 100% claro CUAL llave del panel es la que
# firma. Igual que el bot base (agente-ycloud-main), este bot prueba en orden: BOLD_WEBHOOK_SECRET,
# BOLD_API_KEY, BOLD_SECRET_KEY, y por ultimo una llave vacia (asi firma Bold en modo SANDBOX,
# confirmado en su doc). No hace falta llenar las 3 — deja vacias las que tu panel no te muestre;
# el primer webhook real que llegue deja en los logs cual de todas coincidio.
# BOLD_WEBHOOK_SECRET=
# BOLD_SECRET_KEY=

# --- Avisos técnicos al equipo de desarrollo ---
# [2026-09-13] Cuando un servicio externo falla (LobbyPMS, Bold, Supabase...) el bot manda un
# aviso, además de dejarlo en los logs — ver src/core/pipeline/notificarDesarrollo.ts. Máximo un
# aviso cada 2 horas por la misma falla.
#
# DECISIÓN 2026-09-13: por ahora es por WHATSAPP, al mismo número del bot (YCLOUD_FROM_PHONE_NUMBER,
# +573246166787) — el bot se avisa a sí mismo y Daniel lo revisa ahí mientras se decide un canal
# aparte. Para usar otro número, descomenta y cambia esto:
# ALERTA_TECNICA_WHATSAPP=+573246166787

# --- (pendiente, para más adelante) avisos técnicos por correo ---
# Se dejó construido (src/core/integrations/email.ts) pero SIN USAR — Daniel decidió el
# 2026-09-13 dejarlo en pausa y usar WhatsApp mientras tanto (ver arriba). Cuando se retome, llenar
# estas variables (SMTP estándar — sirve con Gmail + "contraseña de aplicación", o con
# Resend/SendGrid/Mailgun/cualquier otro en modo SMTP) y cambiar notificarDesarrollo.ts para que
# llame a enviarCorreo(...) en vez de mandar el WhatsApp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ALERTA_TECNICA_EMAIL=daniel.pataquiva@lajulitadevelopment.site

# ------------------------------------------------------------------------------------------
# REPORTES DE FALLAS POR WHATSAPP  [2026-09-16]
# Números (separados por coma, con o sin +57) que pueden mandarle al bot un TEXTO o un AUDIO
# que empiece con la palabra "corrige": todo lo que sigue se guarda tal cual como un ticket
# abierto en la tabla `tickets` del panel. Es una lista APARTE de OWNER_WHATSAPP_NUMBERS
# (esos enseñan reglas con /aprende y confirman pagos); acá van solo quienes reportan fallas.
# RESPALDO: lo normal es marcar al usuario en el panel (Usuarios → "puede corregir el bot" + su
# celular; ver sql/users-bot-corrige.sql). Esta variable solo suma números que no estén ahí.
# Vacío y sin fila en la tabla = un "corrige..." se trata como mensaje normal de cliente.
# Ejemplo: REPORTE_FALLAS_NUMBERS=+573001234567,3109876543
REPORTE_FALLAS_NUMBERS=

# --- Simulacro de carga (varios clientes a la vez) -------------------------------------------
# [2026-09-18] Prefijos de números que el bot atiende NORMAL pero a los que nunca les manda un
# WhatsApp de verdad. Sirve para correr `scripts/simulacro-nube.ts` contra el bot ya desplegado
# sin que salga un solo mensaje al mundo real: los números inventados de una simulación caen en
# prefijos reales de Colombia (300, 310, 320...), así que sin esto le llegarían a personas de
# verdad desde el número del negocio.
#
# Lista separada por comas, en dígitos y SIN el "+". Vacío = el bot manda todo como siempre.
# El candado vive en src/channels/whatsapp-ycloud/adapter.ts, el único punto por donde sale un
# mensaje, así que cubre texto, imagen, video y catálogo por igual.
SIMULACRO_PREFIJOS=5730009
