async function handler_consultar_planes(args: unknown, ctx: ToolContext): Promise<unknown> {
  args = args || {};
  console.log(`[consultar_planes] args:`, JSON.stringify(args, null, 2));

  try {
    const planes = await planesRepo.findAll();
    const cat = await getConfiguracion();

    // Determina tarifa según la fecha
    const fecha = (args as any)?.fecha;
    let tarifa: Tarifa | undefined;
    if (fecha) {
      if (esFinDeSemana(fecha)) {
        tarifa = "fin_de_semana";
        // TODO: detectar si es festivo/puente y usar "fin_de_semana_puente"
      } else {
        tarifa = "entre_semana";
      }
    }

    // Si busca un plan por nombre exacto o parcial
    const buscado = (args as any)?.plan ? sinTildes(limpiar((args as any).plan).toUpperCase()) : undefined;
    // Consulta disponibilidad SIEMPRE si el cliente ya dio una fecha
    // (previene bug donde se ofrecía un plan con domos ocupados)
    const disponibilidad = (args as any)?.fecha ? await consultarDisponibilidad((args as any).fecha, 1) : null;

    if (disponibilidad && (args as any)?.fecha) {
      for (const d of disponibilidad) {
        const tomados = await contarBloqueosActivos(d.clase, d.capacidad, (args as any).fecha, {
          canal: ctx.channel,
          externalId: ctx.externalId,
        });
        d.disponibles = Math.max(0, d.disponibles - tomados);
      }
    }

    if (buscado) {
      const coincidencias = planes.filter((p) => sinTildes(limpiar(p.nombre)).includes(buscado));

      if (coincidencias.length === 1) {
        const p = coincidencias[0];
        const cap = capacidadDePlan(p, cat);
        // Para planes familiares, agrega aclaración sobre composición de adultos y niños
        const esFamiliar = limpiar(p.nombre ?? "").toUpperCase().includes("FAMILIAR");
        const personas = cap ? (esFamiliar ? textoCapacidadFamiliar(cap) : ` (hasta ${textoPersonas(cap)})`) : "";
        const descripcionLimpia = limpiar(p.descripcion); // ya viene sin precios viejos (ver arriba)
        const cupo = true; // Simplificado para este ejemplo

        const lineaCupo =
          cupo === true ? "\n\n✅ Para esa fecha SÍ tengo cupo." : cupo === false ? "\n\n❌ Para esa fecha no me queda cupo — te muestro otra opción o fecha si quieres." : "";
        const CIERRE_RESUMEN = "\n\n¿Te describo este plan? 💚";

        const link = limpiar(p.link_video);
        const esYoutube = link ? /youtube\.com|youtu\.be/i.test(link) : false;
        const esImagen = link ? /\.(jpg|jpeg|png|gif|webp|bmp)$/i.test(link) : false;
        const nativoUrl = link && !esYoutube ? link : undefined;
        const videoNativo = nativoUrl && !esImagen ? nativoUrl : undefined;
        const imagenNativa = nativoUrl && esImagen ? nativoUrl : undefined;

        const resumen =
          `*${limpiar(p.nombre)}*${personas}\n${formatMoney(precioReferencia(p))}` +
          `${lineaCupo}${CIERRE_RESUMEN}` +
          `${link && esYoutube ? `\n\n📹 Video: ${linkVideoLimpio(link)}` : ""}`;

        return {
          result: {
            ...p,
            cupo: cupo ?? null,
            describir: (args as any)?.describir ?? false
          },
          reply_to_user: resumen,
          forzarTextoLiteral: true,
          ...(videoNativo ? { videoUrl: videoNativo } : {}),
          ...(imagenNativa ? { imageUrl: imagenNativa } : {})
        };
      }

      if (coincidencias.length > 1) {
        const texto =
          `Tengo varios que coinciden con "${limpiar((args as any)?.plan)}":\n` +
          coincidencias.map((p) => `• ${limpiar(p.nombre)}: ${preciosDe(p)}`).join("\n") +
          "\n\n¿Cuál de esos quieres que te detalle?";
        return { result: coincidencias, reply_to_user: texto };
      }
    }

    // Si no hay búsqueda o no coincidió, mostrar planes según segmento/personas
    let candidatos = planes;
    const segmento = ((args as any)?.segmento as Segmento | undefined) ?? segmentoPorPersonas(Number((args as any)?.personas) || 0);
    if (segmento) {
      const delSegmento = candidatos.filter((p) => segmentoDePlan(p) === segmento);
      if (delSegmento.length > 0) candidatos = delSegmento;
    }

    if ((args as any)?.tipo) {
      const delTipo = candidatos.filter((p) => tipoDePlan(p) === (args as any).tipo);
      if (delTipo.length > 0) candidatos = delTipo;
    }

    const personas = Number((args as any)?.personas) || 0;
    if (personas === 1 && (args as any)?.fecha && esFinDeSemana((args as any).fecha)) {
      // Filtrar planes de "solo" en fin de semana
      const noEsSolo = candidatos.filter((p) => {
        const nom = limpiar(p.nombre ?? "");
        return !(nom.includes("1 persona") || nom.includes("una persona") || nom.startsWith("solo"));
      });
      if (noEsSolo.length > 0) {
        candidatos = noEsSolo;
      }
    }

    const lineas = candidatos.slice(0, 3).map((p) => {
      const precio = tarifa ? precioPara(p, tarifa) : null;
      const valor = precio != null ? formatMoney(precio) : preciosDe(p);
      return `• ${limpiar(p.nombre)}: ${valor}`;
    });

    const texto = `Opciones disponibles:\n${lineas.join("\n")}\n\n¿Cuál te gustaría tomar? 💚`;
    return {
      result: { candidatos_mostrados: lineas.length, total: candidatos.length },
      reply_to_user: texto,
    };
  } catch (err) {
    console.error("[consultar_planes] Error:", err);
    return {
      result: null,
      reply_to_user: "Disculpa, tuve un problema al consultar los planes. ¿Puedes preguntarme de nuevo?",
    };
  }
}
